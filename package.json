{
  "name": "filesdigi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local scripts/run-db-tests.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-types.mjs",
    "db:env": "node scripts/local-env.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "test:kalamassery": "node --env-file=.env.local scripts/check-kalamassery-roles.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
